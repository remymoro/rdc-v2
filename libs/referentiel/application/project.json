{
  "name": "referentiel-application",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/referentiel/application/src",
  "projectType": "library",
  "tags": ["context:referentiel", "layer:application"],
  "targets": {
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": [],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/referentiel/application/tsconfig.lib.json",
          "tsc --noEmit -p libs/referentiel/application/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
