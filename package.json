    "format:check": "nx format:check",
    "test:agent-gate": "node --test tools/agent-gate/agent-gate.spec.mjs",
    "test:reprise": "node --test tools/reprise/*.spec.mjs",
    "verify": "pnpm test:agent-gate && pnpm test:reprise && nx run-many -t lint typecheck test build",
    "agent:gate": "node tools/agent-gate/cli.mjs",
    "e2e": "DATABASE_URL=postgresql://rdc:rdc@localhost:5432/rdc_test UPLOADS_DIR=tmp/uploads-e2e nx e2e api-e2e"
  },
