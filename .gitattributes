# Fins de ligne LF partout, quel que soit l'outil ou le système (Windows,
# WSL, éditeurs, agents). Évite les fichiers « modifiés » sans changement de
# contenu après une conversion en CRLF.
* text=auto eol=lf

# Binaires : jamais convertis.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
